{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 4381",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4381/",
        "http://localhost:4381/apps",
        "http://localhost:4381/apps/alt-text",
        "http://localhost:4381/privacy",
        "http://localhost:4381/support",
        "http://localhost:4381/services",
        "http://localhost:4381/blog"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
