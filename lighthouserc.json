{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 4381",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4381/",
        "http://localhost:4381/image-voice",
        "http://localhost:4381/reorder-loop",
        "http://localhost:4381/count-check",
        "http://localhost:4381/lost-sales",
        "http://localhost:4381/privacy",
        "http://localhost:4381/support"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
